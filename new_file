N = 8

def solve(row, board):
    if row == N:
        print(board)
        return True

    for col in range(N):
        ok = True
        for i in range(row):
            if board[i] == col or abs(board[i] - col) == abs(i - row):
                ok = False
                break
        
        if ok:
            board[row] = col
            if solve(row + 1, board):
                return True

    return False

