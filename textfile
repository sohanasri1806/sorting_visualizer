1. Write a program that contains a string (char pointer) with a value ‘Hello world’. 
The program should XOR and AND each character in this string with 0 and 127, and display the result.
public class XorAnd {
    public static void main(String[] args) {
        String str = "Hello World";
        System.out.println("Original: " + str);
        System.out.print("XOR with 0: ");
        for (int i = 0; i < str.length(); i++) {
            System.out.print((char)(str.charAt(i) ^ 0));
        }
        System.out.print("\nAND with 127: ");
        for (int i = 0; i < str.length(); i++) {
            System.out.print((char)(str.charAt(i) & 127));
        }
    }
}

2a. Caeser Cipher
import java.util.Scanner;

public class CaesarCipher {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text (UPPERCASE): ");
        String text = sc.next();

        System.out.print("Enter key: ");
        int key = sc.nextInt();

        String enc = "";
        String dec = "";

        for(int i=0;i<text.length();i++)
        {
            char ch = text.charAt(i);

            enc += (char)((ch-'A'+key)%26+'A');
        }

        System.out.println("Encrypted : "+enc);

        for(int i=0;i<enc.length();i++)
        {
            char ch = enc.charAt(i);

            dec += (char)((ch-'A'-key+26)%26+'A');
        }

        System.out.println("Decrypted : "+dec);
    }
}

2b. Hill Cipher

import java.util.Scanner;

public class HillCipher {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Encryption key
        int key[][] = {
                {3, 3},
                {2, 5}
        };

        // Inverse key matrix (mod 26)
        int invKey[][] = {
                {15, 17},
                {20, 9}
        };

        System.out.print("Enter Plain Text (UPPERCASE): ");
        String text = sc.next().toUpperCase();

        // Make length even
        if (text.length() % 2 != 0)
            text += "X";

        String cipher = "";

        // ---------- Encryption ----------
        for (int i = 0; i < text.length(); i += 2) {

            int a = text.charAt(i) - 'A';
            int b = text.charAt(i + 1) - 'A';

            int c = (key[0][0] * a + key[0][1] * b) % 26;
            int d = (key[1][0] * a + key[1][1] * b) % 26;

            cipher += (char) (c + 'A');
            cipher += (char) (d + 'A');
        }

        System.out.println("Encrypted Text : " + cipher);

        // ---------- Decryption ----------
        String plain = "";

        for (int i = 0; i < cipher.length(); i += 2) {

            int c = cipher.charAt(i) - 'A';
            int d = cipher.charAt(i + 1) - 'A';

            int a = (invKey[0][0] * c + invKey[0][1] * d) % 26;
            int b = (invKey[1][0] * c + invKey[1][1] * d) % 26;

            plain += (char) (a + 'A');
            plain += (char) (b + 'A');
        }

        System.out.println("Decrypted Text : " + plain);
    }
}

3a. DES algorithm
import javax.crypto.Cipher;
import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import java.util.Base64;
import java.util.*;
public class DESExample {

    public static void main(String[] args) throws Exception {

        Scanner sc=new Scanner(System.in);
        // Generate DES Key
        KeyGenerator keyGen = KeyGenerator.getInstance("DES");
        SecretKey key = keyGen.generateKey();

        // Create Cipher
        Cipher cipher = Cipher.getInstance("DES");

        System.out.print("Enter string: ");
        String plainText = sc.next();

        // Encryption
        cipher.init(Cipher.ENCRYPT_MODE, key);
        byte[] encrypted = cipher.doFinal(plainText.getBytes());

        System.out.println("Original Text  : " + plainText);
        System.out.println("Encrypted Text : " +
                Base64.getEncoder().encodeToString(encrypted));

        // Decryption
        cipher.init(Cipher.DECRYPT_MODE, key);
        byte[] decrypted = cipher.doFinal(encrypted);

        System.out.println("Decrypted Text : " +
                new String(decrypted));
    }
}

